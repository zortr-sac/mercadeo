# Nexo Mentor — plantilla de variables de entorno.
# Copia este archivo a `.env.local` y rellena los valores. NUNCA subas `.env.local`.

# Fuente de datos: "supabase" en producción, "mock" para UX sin backend.
NEXT_PUBLIC_DATA_SOURCE=supabase

NEXT_PUBLIC_APP_NAME=Nexo Mentor
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NUNCA con prefijo NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (genera con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
